{
    "data": {
        "train_path": "data/train_transaction.csv"
    },
    "ewm": {
        "span": 5,
        "adjust": false
    },
    "validation": {
        "train_max_day": 120,
        "test_min_day": 150
    },
    "feature_selection": {
        "null_threshold": 0.5,
        "variance_threshold": 0.01,
        "corr_threshold": 0.95,
        "top_k_features": 100
    },
    "model_params": {
        "n_estimators": 500,
        "learning_rate": 0.05,
        "max_depth": 7,
        "num_leaves": 31,
        "min_child_samples": 50,
        "random_state": 42,
        "scale_pos_weight": 5
    },
    "post_processing": {
        "prediction_threshold": 0.5,
        "infected_card_threshold": 0.90,
        "infected_card_expiry_days": 14
    }
}